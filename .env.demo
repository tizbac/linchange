POSTGRES_PASSWORD=linchange
JWT_SECRET=demo-jwt-secret-change-in-production
LDAP_BIND_PASSWORD=
# Host-side ports. docker-compose.yml reads these, so the container keeps the
# standard ports while the host publishes the 5-prefixed ones.
LINCHANGE_SMTP_PORT=5025
LINCHANGE_SMTPS_PORT=5465
LINCHANGE_SUBMISSION_PORT=5587
LINCHANGE_IMAP_PORT=5143
LINCHANGE_IMAPS_PORT=5993
LINCHANGE_POP3_PORT=5110
LINCHANGE_POP3S_PORT=5995
LINCHANGE_HTTP_PORT=58080
LINCHANGE_HTTPS_PORT=58443
