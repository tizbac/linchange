# Build output
/bin/
/data/
# Where package.sh and package-docker.sh leave the .deb
/dist/

# Local secrets and generated configuration
.env
/.env
/certs/
/.certs/
linchange.dev.yaml
.e2e-linchange.yaml

# Web interface
/web/node_modules/
/web/.angular/
/web/dist/
/internal/httpapi/web/dist/

# Go
*.test
*.out
coverage.*

# Test logs
.test-integration.log

# Python bytecode from the e2e suite
__pycache__/

# The binary `go build` drops at the repository root. Anchored, because an
# unanchored name would also swallow the cmd/linchange/ package directory, so
# every new file added to that package would vanish from `git status`.
/linchange
