# Multi-stage Dockerfile for building linchange .deb package
# Stage 1: Builder - compiles Go binary and builds web frontend
# Stage 2: Packager - creates .deb package structure

# Build stage - uses Debian 13 (trixie) as base
FROM debian:trixie-slim AS builder

# Install build dependencies including Node.js 22+
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    golang-go \
    curl \
    ca-certificates \
    gnupg \
    dpkg-dev \
    build-essential \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22+ from NodeSource (includes npm)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Match the npm major declared in web/package.json's packageManager. Node 22's
# bundled npm 10 resolves optional platform bindings differently and rejects the
# npm 12 lockfile; using the same version here keeps `npm ci` reproducible.
RUN npm install -g npm@11.20.0

# Set working directory
WORKDIR /build

# Declared here as well as in the packager stage: an ARG only exists in the
# stage that declares it, so the version has to be re-declared for the binary
# build to see it (otherwise ${VERSION} expands to empty and the binary
# reports dev).
ARG VERSION=dev

# Copy Go module files first for caching
COPY go.mod go.sum ./
RUN go mod download

# Copy web package files for npm caching.
#
# web/scripts comes with them: npm ci runs the postinstall hook, and that hook
# is a file in this directory. Copying only the manifests leaves the install
# failing on a missing module, which reads as a broken dependency rather than
# as a file nobody copied.
COPY web/package*.json ./web/
COPY web/scripts/ ./web/scripts/
RUN cd /build/web && npm ci

# Copy all source code
COPY . .

# Build web frontend
WORKDIR /build/web
RUN npm run build

# Build Go binary
WORKDIR /build
RUN CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${VERSION:-dev}" -o /build/linchange ./cmd/linchange

# Package stage
FROM debian:trixie-slim AS packager

# Install packaging tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    dpkg-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /package

# Copy built artifacts
COPY --from=builder /build/linchange /package/usr/bin/linchange
COPY --from=builder /build/web/dist/linchange-web/browser /package/usr/share/linchange/web

# Copy config example
RUN mkdir -p /package/etc/linchange
COPY config/linchange.example.yaml /package/etc/linchange/linchange.example.yaml

# Create systemd service
RUN mkdir -p /package/usr/lib/systemd/system
RUN printf '[Unit]\nDescription=linchange mail server\nAfter=network.target postgresql.service\nWants=postgresql.service\n\n[Service]\nType=simple\nUser=linchange\nGroup=linchange\nExecStart=/usr/bin/linchange --config /etc/linchange/linchange.yaml --web-dir /usr/share/linchange/web\nRestart=on-failure\nRestartSec=5\nLimitNOFILE=65536\nNoNewPrivileges=true\nAmbientCapabilities=CAP_NET_BIND_SERVICE\nPrivateTmp=true\nProtectSystem=strict\nProtectHome=true\nReadWritePaths=/var/lib/linchange /var/log/linchange\nCapabilityBoundingSet=CAP_NET_BIND_SERVICE\n\n[Install]\nWantedBy=multi-user.target\n' > /package/usr/lib/systemd/system/linchange.service

# Create tmpfiles.d
RUN mkdir -p /package/usr/lib/tmpfiles.d
RUN printf 'd /var/lib/linchange 0750 linchange linchange -\nd /var/lib/linchange/blobs 0750 linchange linchange -\nd /var/log/linchange 0750 linchange linchange -\nd /etc/linchange 0750 root linchange -\n' > /package/usr/lib/tmpfiles.d/linchange.conf

# Create sysusers.d
RUN mkdir -p /package/usr/lib/sysusers.d
RUN printf 'u linchange - "linchange mail server" /var/lib/linchange\ng linchange\n' > /package/usr/lib/sysusers.d/linchange.conf

# Create logrotate config
RUN mkdir -p /package/etc/logrotate.d
RUN printf '/var/log/linchange/*.log {\n    daily\n    missingok\n    rotate 14\n    compress\n    delaycompress\n    notifempty\n    create 0640 linchange linchange\n    sharedscripts\n    postrotate\n        systemctl reload linchange > /dev/null 2>&1 || true\n    endscript\n}\n' > /package/etc/logrotate.d/linchange

# Create DEBIAN control files
ARG VERSION=dev
ARG ARCH=amd64
RUN mkdir -p /package/DEBIAN
RUN printf 'Package: linchange\nVersion: %s\nArchitecture: %s\nMaintainer: linchange <admin@linchange.example>\nDescription: Self-hosted mail server with webmail, calendar, and admin panel\n A complete self-hosted mail server with:\n  - SMTP/IMAP/POP3\n  - MAPI/HTTP (Outlook native)\n  - CalDAV/CardDAV\n  - ActiveSync (EAS)\n  - EWS (Exchange Web Services)\n  - Autodiscover\n  - Webmail with rich text editor\n  - Calendar with scheduling assistant\n  - Admin panel for domains, users, aliases, shared mailboxes\n  - DKIM signing\n  - LDAP authentication\n  - Full-text search\nHomepage: https://github.com/linchange/linchange\nLicense: GPL-3.0-or-later\nDepends: systemd (>= 247), postgresql-client (>= 14), ca-certificates, tzdata\nRecommends: postgresql (>= 14)\nConflicts: courier-imap, courier-pop, dovecot-imapd, dovecot-pop3d, postfix, exim4\nProvides: mail-transport-agent, imap-server, pop3-server\nSection: mail\nPriority: optional\n' "${VERSION}" "${ARCH}" > /package/DEBIAN/control

# Maintainer scripts live in packaging/debian and are shared with package.sh.
# They are copied rather than printed here: a printf-escaped shell script
# cannot be reviewed, linted, or run locally before packaging.
COPY packaging/debian/postinst packaging/debian/prerm packaging/debian/postrm /package/DEBIAN/
RUN chmod 755 /package/DEBIAN/postinst /package/DEBIAN/prerm /package/DEBIAN/postrm

# Build the .deb package
RUN dpkg-deb --build /package /package.deb